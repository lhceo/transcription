# このファイルをコピーして `.env` を作成してください。
# `.env` は .gitignore に含まれており、Git にコミットされません。
#
#   cp .env.example .env
#   # 必要に応じて値を編集
#

# 実行環境（development / production）
APP_ENV=development

# 開発用 Web サーバの設定
APP_HOST=127.0.0.1
APP_PORT=8000

# セッション署名キー（本番では強力なランダム文字列に変えること）
# Python で生成する例: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# 認証で許可するメールドメイン（カンマ区切り、Phase 2 で使用）
ALLOWED_EMAIL_DOMAINS=

# Google OAuth の設定（Phase 2 で使用）
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# AssemblyAI API キー（Phase 4 で使用）
# ASSEMBLYAI_API_KEY=
