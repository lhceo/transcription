# このファイルをコピーして `.env` を作成してください。
# `.env` は .gitignore に含まれており、Git にコミットされません。
#
#   cp .env.example .env
#   # 必要に応じて値を編集
#

# 実行環境（development / production）
# 本番（Railway）ではここを production にすると Cookie が Secure 属性付きになる
APP_ENV=development

# 開発用 Web サーバの設定
APP_HOST=127.0.0.1
APP_PORT=8000

# セッション署名キー（本番では強力なランダム文字列に変えること）
# Python で生成する例:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# 認証で許可するメールドメイン（カンマ区切り）
# 例: lionheart.co.jp
# 空欄の場合、認証は許可されない（誰もログインできない）
ALLOWED_EMAIL_DOMAINS=

# Google OAuth の設定（Phase 2 で使用）
# Google Cloud Console > APIs & Services > Credentials で OAuth 2.0 クライアント ID を作成し、
# その値をここに貼り付ける。
# 詳しい手順は Phase 2 のセッションで案内します。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth のコールバック URL。
# ローカル開発時は下記のままで OK。
# 本番（Railway デプロイ後）は https://<your-app>.railway.app/auth/google/callback などに変更する。
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# AssemblyAI API キー（Phase 4 で使用）
# 取得手順:
# 1. https://www.assemblyai.com/dashboard/signup でアカウント作成
# 2. ダッシュボードの「API Keys」セクションで「Default API Key」をコピー
# 3. 下記に貼り付け
ASSEMBLYAI_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# 本番デプロイ（Railway 等）でのみ設定する変数
# ──────────────────────────────────────────────────────────────────────

# DB の保存場所。Railway では永続ボリュームを /data にマウントし、
# DATABASE_URL=sqlite:////data/app.db を指定する（スラッシュ4つ = 絶対パス）
# DATABASE_URL=sqlite:////data/app.db

# 一時アップロード先。Railway では /tmp 配下を使う（ephemeral でOK、処理後即削除）
# UPLOAD_TMP_DIR=/tmp/transcription_uploads
